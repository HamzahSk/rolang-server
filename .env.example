# Required MongoDB configuration. Percent-encode special characters in credentials.
# mongodb+srv enables TLS automatically. Never log or commit a real connection string.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Explicit database name; the URI path never overrides this setting.
MONGODB_DB_NAME=rolang

# Optional application settings, independent of the database.
# SESSION_DAYS=30
# CORS_ORIGINS=https://your-browser-app.example
# PORT=3000
