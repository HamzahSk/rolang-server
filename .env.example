# Required for every API and MongoDB administration script. Percent-encode
# special characters in Atlas credentials. TLS is automatic with mongodb+srv.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Explicit database name; the URI's path never overrides this setting.
MONGODB_DB_NAME=rolang
# Optional connections per warm Vercel instance (default 5, clamped to 1-20).
MONGODB_MAX_POOL_SIZE=5
SESSION_DAYS=30
# Optional comma-separated browser origins. Android does not need CORS.
CORS_ORIGINS=
PORT=3000

# MIGRATION ONLY: existing PostgreSQL source; never read by the running API.
# Use a read-only account with SELECT on all source tables and a direct endpoint.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/rolang?sslmode=require
# Optional source schema (default public); source SQL migrations are retained.
# POSTGRES_SCHEMA=public

# DISPOSABLE LOCAL TESTS ONLY. Tests never fall back to production variables.
# Start real databases with docker compose -f compose.test.yml up -d --wait.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=rs0&directConnection=true
# TEST_POSTGRES_URL=postgresql://rolang_test:local-test-password@127.0.0.1:54329/rolang_test
# Local Docker only: enables real MongoDB failure/timeout tests.
# TEST_MONGODB_FAILPOINTS=1
