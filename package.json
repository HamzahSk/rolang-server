{
  "name": "rolang-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch src/local.js",
    "start": "node src/local.js",
    "build": "npm run check && node scripts/build.js",
    "doctor": "node scripts/doctor.js",
