# Original PostgreSQL release configuration, retained for rollback reference.
# The migrated runtime reads only the MongoDB configuration at ../../.env.example.
# The source importer reads DATABASE_URL and optional POSTGRES_SCHEMA.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/rolang?sslmode=require
DATABASE_POOL_SIZE=3
SESSION_DAYS=30
# Optional comma-separated browser origins. Android does not need CORS.
CORS_ORIGINS=
PORT=3000
